# Copy to .env and fill in whichever provider you use. All of them are optional:
# search, preview and the heatmap never call a network.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Point a provider at a stub or a proxy. The end to end chat test uses this.
ANTHROPIC_BASE_URL=
OPENAI_BASE_URL=

# Tracing. Leave blank to disable, which is the default.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
