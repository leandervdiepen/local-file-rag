# Copy to .env and fill in whichever provider you want to answer questions.
# Every one is optional: search, the page preview and the heatmap never call a
# network, and the app works without any of these.
#
# This file is for running from source. The shipped app never reads it. Keys
# entered in its settings screen are encrypted by the OS keychain and handed
# to the sidecar over the local API, which keeps them in memory only (D41).

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
